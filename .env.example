# Reference only: the app reads host environment variables, not this file.
# Fill these privately in Vercel Settings > Environment Variables.
APP_ENV=production
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_MODE=verify-full
DB_SSL_CA_BASE64=
SESSION_TTL=1800
# For local XAMPP only, alternatively supply the path to a private local CA:
# DB_SSL_CA=C:/path/outside/webroot/ca.pem
# To use a disposable local DB without TLS: APP_ENV=local, DB_SSL_MODE=disabled.
# That exception is rejected whenever VERCEL is present.
