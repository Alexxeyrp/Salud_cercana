{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.git/**,.github/**,.vercel/**,.env*,**/*.pem,**/*.key,**/*.sql,tests/**,scripts/**,docs/**,database/**,README.md,vercel.json,.vercelignore,test_*.php,**/*.log,work/**,outputs/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
